# App
APP_NAME=mycar-api
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# CORS - JSON list of allowed origins
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Database
# POSTGRES_HOST=db          -> when the API runs inside docker-compose
# POSTGRES_HOST=localhost   -> when the API runs outside Docker (local dev)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=mycar

# Optional: overrides the URL assembled from the variables above
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/mycar

# Security (placeholder for future authentication/JWT)
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database used by the test suite (should be separate from the dev one)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mycar_test
